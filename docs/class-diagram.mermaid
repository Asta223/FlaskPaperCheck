classDiagram
    class User {
        +int id PK
        +str username UK
        +str employee_no UK
        +str name
        +str email
        +str phone
        +str password_hash
        +str position
        +int department_id FK
        +date hire_date
        +date leave_date
        +bool is_active
        +datetime created_at
        +set_password(pwd)
        +check_password(pwd)
    }
    class Role {
        +int id PK
        +str code UK
        +str name
        +bool is_builtin
        +str remark
    }
    class Permission {
        +int id PK
        +str code UK
        +str name
        +str module
    }
    class Department {
        +int id PK
        +str name
        +int parent_id FK
        +int leader_id FK
        +int sort_order
        +bool is_active
        +get_tree() list
    }
    class AttendanceRecord {
        +int id PK
        +int user_id FK
        +date work_date
        +datetime check_in_at
        +datetime check_out_at
    }
    class WorkOrder {
        +int id PK
        +str order_no UK
        +str product_name
        +int quantity
        +date due_date
        +int leader_id FK
        +str status
        +int created_by FK
        +datetime created_at
    }
    class WorkOrderStep {
        +int id PK
        +int work_order_id FK
        +str name
        +int seq
        +str status
        +int operator_id FK
        +datetime started_at
        +datetime finished_at
        +str remark
    }
    class MaterialCategory {
        +int id PK
        +str name
        +int parent_id FK
    }
    class Material {
        +int id PK
        +str code UK
        +str name
        +str spec
        +str unit
        +int category_id FK
        +bool is_active
    }
    class Warehouse {
        +int id PK
        +str name UK
        +str location
        +bool is_active
    }
    class Inventory {
        +int id PK
        +int warehouse_id FK
        +int material_id FK
        +int quantity
        +int warn_threshold
    }
    class StockDocument {
        +int id PK
        +str doc_no UK
        +str doc_type
        +int warehouse_id FK
        +int material_id FK
        +int quantity
        +int handler_id FK
        +int related_order_id FK
        +str remark
        +int created_by FK
        +datetime created_at
    }
    class FileCategory {
        +int id PK
        +str name
        +int parent_id FK
    }
    class FactoryFile {
        +int id PK
        +str name
        +str original_filename
        +str stored_filename
        +str file_ext
        +int size_bytes
        +int category_id FK
        +str visibility_type
        +int uploaded_by FK
        +datetime created_at
        +bool is_active
    }
    class ChatMessage {
        +int id PK
        +int sender_id FK
        +int receiver_id FK
        +text content
        +bool is_read
        +datetime created_at
    }

    User "1" --> "0..*" AttendanceRecord
    User "1" --> "0..*" ChatMessage
    User "0..*" -- "0..*" Role : user_roles
    Role "0..*" -- "0..*" Permission : role_permissions
    User "0..*" --> "0..1" Department
    Department "1" --> "0..1" User : leader(use_alter)
    Department "0..*" --> "0..1" Department : parent
    WorkOrder "1" *-- "1..*" WorkOrderStep
    User "1" --> "0..*" WorkOrder : leader
    MaterialCategory "0..*" --> "0..1" MaterialCategory : parent
    Material "0..*" --> "0..1" MaterialCategory
    Inventory "0..*" --> "1" Warehouse
    Inventory "0..*" --> "1" Material
    StockDocument "0..*" --> "1" Warehouse
    StockDocument "0..*" --> "1" Material
    StockDocument "0..*" --> "0..1" WorkOrder
    FactoryFile "0..*" --> "0..1" FileCategory
    FactoryFile "0..*" -- "0..*" Role : file_role_visibility
