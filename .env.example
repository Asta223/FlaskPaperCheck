# FlaskPaperCheck（工厂管理系统）环境变量示例
# 复制为 .env 后按需修改（项目启动时会自动读取）

# 密钥（生产环境务必改成随机长字符串）
SECRET_KEY=change-me-to-a-random-secret

# 数据库：默认 MySQL。开发/演示用 SQLite 时把 DB_ENGINE 设为 sqlite
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123
DB_NAME=factory_mgmt
# 或者直接用完整连接串（优先级最高）：
# DATABASE_URL=mysql+pymysql://root:123@localhost:3306/factory_mgmt?charset=utf8mb4

# 文件上传目录（一般不用改）
# UPLOAD_FOLDER=data/uploads
