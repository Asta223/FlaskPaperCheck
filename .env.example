# FlaskPaperCheck 环境变量示例
# 复制为 .env 后按需修改（项目启动时会自动读取）

# 密钥（生产环境务必改成随机长字符串）
SECRET_KEY=change-me-to-a-random-secret

# 数据库：默认 MySQL。若使用 SQLite 开发，把 DB_ENGINE 设为 sqlite
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123
DB_NAME=paper_check
# 或者直接用完整连接串（优先级最高）：
# DATABASE_URL=mysql+pymysql://root:123@localhost:3306/paper_check?charset=utf8mb4

# 上传目录 / 模型路径（一般不用改）
# UPLOAD_FOLDER=data/uploads
# DOC2VEC_MODEL_PATH=models/doc2vec.model

# 是否启用参考语料库（1 启用 / 0 关闭）
USE_REFERENCE_CORPUS=1
