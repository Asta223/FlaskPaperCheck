# 工厂管理系统环境变量示例
# 复制为 .env 后按需修改（项目启动时会自动读取）

# 密钥（生产环境务必改成随机长字符串）
SECRET_KEY=change-me-to-a-random-secret

# 数据库：本示例默认 MySQL；完全没有任何 DB_* 配置时自动回退到本地 SQLite
# 开发/演示用 SQLite 时把 DB_ENGINE 设为 sqlite
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123
DB_NAME=FactoryManagementSystem
# 或者直接用完整连接串（优先级最高）：
# DATABASE_URL=mysql+pymysql://root:123@localhost:3306/FactoryManagementSystem?charset=utf8mb4

# 文件上传目录（一般不用改）
# UPLOAD_FOLDER=data/uploads

# 导入员工 CSV/Excel 时，新建账号的初始密码（导出字段中没有密码列）
# IMPORT_DEFAULT_PASSWORD=123456

# 服务启动配置（供 启动系统.bat / start_server.py 使用）
# 0.0.0.0 表示本机和局域网都可访问；只允许本机访问时改成 127.0.0.1
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SERVER_THREADS=8
# 设为 0 可禁止双击启动时自动打开浏览器
OPEN_BROWSER=1
